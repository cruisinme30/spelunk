{
  "name": "unified-search",
  "displayName": "Unified Search",
  "description": "One search box for file names, code and Git history across every repo in the workspace.",
  "version": "0.1.0",
  "publisher": "unified-search",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cruisinme30/unified-search.git",
    "directory": "extension"
  },
  "bugs": {
    "url": "https://github.com/cruisinme30/unified-search/issues"
  },
  "homepage": "https://github.com/cruisinme30/unified-search#readme",
  "keywords": [
    "search",
    "code search",
    "git history",
    "grep",
    "quick open",
    "find in files",
    "blame",
    "author",
    "commits"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "gen": "node ../protocol/gen.mjs",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:offline": "tsc -p tsconfig.offline.json",
    "test": "node build.mjs --tests && node --test \"dist-test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "unifiedSearch.open",
        "title": "Unified Search: Open"
      },
      {
        "command": "unifiedSearch.openHelp",
        "title": "Unified Search: Open Help"
      },
      {
        "command": "unifiedSearch.nextResult",
        "title": "Unified Search: Next Result"
      },
      {
        "command": "unifiedSearch.prevResult",
        "title": "Unified Search: Previous Result"
      },
      {
        "command": "unifiedSearch.rebuildIndex",
        "title": "Unified Search: Rebuild Index"
      },
      {
        "command": "unifiedSearch.restartDaemon",
        "title": "Unified Search: Restart Search"
      }
    ],
    "keybindings": [
      {
        "command": "unifiedSearch.open",
        "key": "ctrl+p",
        "mac": "cmd+p",
        "when": "config.unifiedSearch.shortcut.preset == 'quickOpen'"
      },
      {
        "command": "workbench.action.quickOpen",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "config.unifiedSearch.shortcut.preset == 'quickOpen'"
      },
      {
        "command": "unifiedSearch.open",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "config.unifiedSearch.shortcut.preset == 'findInFiles'"
      },
      {
        "command": "unifiedSearch.nextResult",
        "key": "f4",
        "when": "unifiedSearch.hasResults && !searchViewletFocus"
      },
      {
        "command": "unifiedSearch.prevResult",
        "key": "shift+f4",
        "when": "unifiedSearch.hasResults && !searchViewletFocus"
      }
    ],
    "configuration": {
      "title": "Unified Search",
      "properties": {
        "unifiedSearch.shortcut.preset": {
          "type": "string",
          "enum": [
            "quickOpen",
            "findInFiles",
            "none"
          ],
          "default": "quickOpen",
          "scope": "application",
          "enumDescriptions": [
            "⌘P / Ctrl+P opens Unified Search; Quick Open moves to ⌥⌘P / Ctrl+Alt+P.",
            "⇧⌘F / Ctrl+Shift+F opens Unified Search; Quick Open is unchanged.",
            "No default shortcut. Bind unifiedSearch.open yourself."
          ],
          "description": "Which key opens Unified Search."
        },
        "unifiedSearch.caseSensitive": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Match case by default. A case: operator in the query always wins."
        },
        "unifiedSearch.defaultCount": {
          "type": "integer",
          "default": 500,
          "minimum": 1,
          "maximum": 50000,
          "scope": "resource",
          "description": "Results per page when the query has no count: operator."
        },
        "unifiedSearch.typingDelayMs": {
          "type": "integer",
          "default": 120,
          "minimum": 0,
          "maximum": 1000,
          "scope": "application",
          "description": "Milliseconds to wait after a keystroke before searching."
        },
        "unifiedSearch.open.trigger": {
          "type": "string",
          "enum": [
            "doubleClick",
            "singleClick"
          ],
          "default": "doubleClick",
          "scope": "application",
          "description": "Whether a single click or a double click opens a result. A single click always previews."
        },
        "unifiedSearch.open.preview": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Open results in a preview editor that the next result replaces."
        },
        "unifiedSearch.open.closeOnOpen": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Hide the search panel after opening a result. F4 keeps stepping through the results."
        },
        "unifiedSearch.index.historyDepth": {
          "type": "string",
          "enum": [
            "6m",
            "2y",
            "all"
          ],
          "default": "2y",
          "scope": "resource",
          "enumDescriptions": [
            "Last 6 months",
            "Last 2 years",
            "Everything"
          ],
          "description": "How much Git history to index for author:, msg: and history search."
        },
        "unifiedSearch.index.symbols": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Index symbol definitions for sym: (uses universal-ctags when installed)."
        },
        "unifiedSearch.index.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/vendor/**",
            "**/node_modules/**",
            "**/*.min.js"
          ],
          "scope": "resource",
          "description": "Glob patterns never indexed, in current files or in history."
        },
        "unifiedSearch.index.includeIgnored": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Also index files matched by .gitignore."
        },
        "unifiedSearch.index.maxFileSizeKB": {
          "type": "integer",
          "default": 1024,
          "minimum": 1,
          "scope": "resource",
          "description": "Skip files larger than this."
        },
        "unifiedSearch.index.location": {
          "type": "string",
          "default": "~/.unified-search/index",
          "scope": "machine",
          "description": "Where indexes are stored. Never synced, because paths differ between computers."
        },
        "unifiedSearch.ui.showParsedQuery": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Show the parsed query as chips under the search box."
        },
        "unifiedSearch.ui.recentQueries": {
          "type": "integer",
          "default": 20,
          "minimum": 0,
          "maximum": 100,
          "scope": "application",
          "description": "How many recent queries to remember."
        }
      }
    }
  }
}
