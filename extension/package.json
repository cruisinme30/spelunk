{
  "name": "spelunk",
  "displayName": "Spelunk",
  "description": "One search box for file names, code and Git history across every repo in the workspace.",
  "version": "1.0.0",
  "publisher": "spelunk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cruisinme30/spelunk.git",
    "directory": "extension"
  },
  "bugs": {
    "url": "https://github.com/cruisinme30/spelunk/issues"
  },
  "homepage": "https://github.com/cruisinme30/spelunk#readme",
  "keywords": [
    "search",
    "code search",
    "git history",
    "grep",
    "quick open",
    "find in files",
    "blame",
    "author",
    "commits"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js",
    "dist/webview",
    "bin",
    "LICENSE"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "gen": "node ../protocol/gen.mjs",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:offline": "tsc -p tsconfig.offline.json",
    "test": "node build.mjs --tests && node --test \"dist-test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "spelunk.open",
        "title": "Spelunk: Open"
      },
      {
        "command": "spelunk.openHelp",
        "title": "Spelunk: Open Help"
      },
      {
        "command": "spelunk.nextResult",
        "title": "Spelunk: Next Result"
      },
      {
        "command": "spelunk.prevResult",
        "title": "Spelunk: Previous Result"
      },
      {
        "command": "spelunk.rebuildIndex",
        "title": "Spelunk: Rebuild Index"
      },
      {
        "command": "spelunk.restartDaemon",
        "title": "Spelunk: Restart Search"
      },
      {
        "command": "spelunk.showWelcome",
        "title": "Spelunk: Show Welcome"
      }
    ],
    "keybindings": [
      {
        "command": "spelunk.open",
        "key": "ctrl+p",
        "mac": "cmd+p",
        "when": "config.spelunk.shortcut.preset == 'quickOpen'"
      },
      {
        "command": "workbench.action.quickOpen",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "config.spelunk.shortcut.preset == 'quickOpen'"
      },
      {
        "command": "spelunk.open",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "config.spelunk.shortcut.preset == 'findInFiles'"
      },
      {
        "command": "spelunk.nextResult",
        "key": "f4",
        "when": "spelunk.hasResults && !searchViewletFocus"
      },
      {
        "command": "spelunk.prevResult",
        "key": "shift+f4",
        "when": "spelunk.hasResults && !searchViewletFocus"
      }
    ],
    "configuration": {
      "title": "Spelunk",
      "properties": {
        "spelunk.shortcut.preset": {
          "type": "string",
          "enum": [
            "quickOpen",
            "findInFiles",
            "none"
          ],
          "default": "quickOpen",
          "scope": "application",
          "enumDescriptions": [
            "⌘P / Ctrl+P opens Spelunk; Quick Open moves to ⌥⌘P / Ctrl+Alt+P.",
            "⇧⌘F / Ctrl+Shift+F opens Spelunk; Quick Open is unchanged.",
            "No default shortcut. Bind spelunk.open yourself."
          ],
          "description": "Which key opens Spelunk."
        },
        "spelunk.caseSensitive": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Match case by default. A case: operator in the query always wins."
        },
        "spelunk.defaultCount": {
          "type": "integer",
          "default": 500,
          "minimum": 1,
          "maximum": 50000,
          "scope": "resource",
          "description": "Results per page when the query has no count: operator."
        },
        "spelunk.typingDelayMs": {
          "type": "integer",
          "default": 120,
          "minimum": 0,
          "maximum": 1000,
          "scope": "application",
          "description": "Milliseconds to wait after a keystroke before searching."
        },
        "spelunk.open.trigger": {
          "type": "string",
          "enum": [
            "doubleClick",
            "singleClick"
          ],
          "default": "doubleClick",
          "scope": "application",
          "description": "Whether a single click or a double click opens a result. A single click always previews."
        },
        "spelunk.open.preview": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Open results in a preview editor that the next result replaces."
        },
        "spelunk.open.closeOnOpen": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Hide the search panel after opening a result, except to the side. F4 keeps stepping through the results."
        },
        "spelunk.index.historyDepth": {
          "type": "string",
          "enum": [
            "6m",
            "2y",
            "all"
          ],
          "default": "2y",
          "scope": "resource",
          "enumDescriptions": [
            "Last 6 months",
            "Last 2 years",
            "Everything"
          ],
          "description": "How much Git history to index for author:, msg: and history search."
        },
        "spelunk.index.symbols": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Index symbol definitions for symbol: (s:)."
        },
        "spelunk.index.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/vendor/**",
            "**/node_modules/**",
            "**/*.min.js"
          ],
          "scope": "resource",
          "description": "Glob patterns never indexed, in current files or in history."
        },
        "spelunk.index.includeIgnored": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Also index files matched by .gitignore."
        },
        "spelunk.index.maxFileSizeKB": {
          "type": "integer",
          "default": 1024,
          "minimum": 1,
          "scope": "resource",
          "description": "Skip files larger than this."
        },
        "spelunk.index.location": {
          "type": "string",
          "default": "~/.spelunk/index",
          "scope": "machine",
          "description": "Where indexes are stored. Never synced, because paths differ between computers."
        },
        "spelunk.ui.showParsedQuery": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Show the parsed query as chips under the search box."
        },
        "spelunk.ui.recentQueries": {
          "type": "integer",
          "default": 20,
          "minimum": 0,
          "maximum": 100,
          "scope": "application",
          "description": "How many recent queries to remember."
        }
      }
    }
  }
}
